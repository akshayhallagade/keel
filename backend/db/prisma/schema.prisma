generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Required by the installed Prisma 6.19.3 CLI (prisma validate/migrate fail without it).
  // prisma.config.ts also sets datasource.url; drop this line only once on Prisma 7.
  url = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  // --- Onboarding answers ---
  // Stored as free text, not enums: the option lists are product copy that changes
  // often, and an enum change costs a migration every time. Answer ids map 1:1 to
  // QUESTIONS in apps/web/src/pages/onboarding/Onboarding.tsx.
  // Note: this is the user's job situation, NOT a permission level — hence
  // "occupation", so `role` stays free if access control ever lands.
  occupation      String? // "Working professional", "Student", ...
  livingSituation String? // "Living alone", "With family", ...
  moneyHabits     String? // "I track every rupee", ...
  investing       String? // "Yes, actively", "Just PF / basic savings", ...
  organization    String? // "Pretty on top of things", ...
  hobbyInterest   String? // "Reading", "Fitness / wellness", ...
  reminderStyle   String? // "Frequent nudges", "One daily summary", ...
  primaryGoal     String? // "Get my finances in order", ...

  /// Null until onboarding is finished — this is what decides login -> onboarding vs login -> home.
  onboardedAt DateTime?

  // --- Account ---
  /// IANA zone name. The morning digest, due-date alerts and SIP reminders all
  /// fire at a wall-clock time, so none of them are correct without this.
  timezone String @default("Asia/Kolkata")

  /// Null until the address is confirmed. The column lands ahead of the verify
  /// flow because "who confirmed, and when" cannot be backfilled afterwards.
  emailVerifiedAt DateTime?

  /// Set on each successful login. Cheapest possible usage signal.
  lastLoginAt DateTime?

  /// Access tokens issued before this instant are rejected, so changing a password
  /// kicks out anyone holding a stolen 7-day token instead of waiting it out.
  passwordChangedAt DateTime @default(now())

  // --- Preferences ---
  accent     String  @default("#C64F3B") // hex, one of ACCENTS in seedData.ts
  theme      String  @default("light") // "light" | "dark"
  weekStart  String  @default("MON") @db.VarChar(3)
  prefQuote  Boolean @default(true) // daily resurfaced quote on Today
  prefDigest Boolean @default(true) // morning digest email
  prefAlerts Boolean @default(true) // due-date push alerts
  prefSip    Boolean @default(false) // SIP reminders

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos Todo[]

  @@map("users")
}

/// Which list a todo sits in on the Todos screen.
/// Deliberately separate from dueAt: the user picks the bucket, and a "this
/// week" todo may still have no date at all. See docs/decisions.md.
enum TodoBucket {
  TODAY
  THIS_WEEK
  SOMEDAY
}

model Todo {
  id String @id @default(cuid())

  /// Every row has an owner, and every query filters by it. onDelete: Cascade
  /// so closing an account takes its data with it.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String @db.VarChar(500)
  /// Free text, matching the area chips (FINANCE, HOME, HEALTH, ...). Not an
  /// enum: these are product copy and change more often than a migration is
  /// worth.
  area String @db.VarChar(40)

  bucket TodoBucket @default(TODAY)

  /// A real instant, never a phrase like "OVERDUE 2D". Whether something is
  /// overdue is worked out when it is read, against the reader's clock.
  /// Null means no date — the Someday pile.
  dueAt DateTime?

  /// Top 3 on the Today screen.
  starred Boolean @default(false)

  /// When it was ticked off. Null means still open — this doubles as the
  /// "done" flag, and keeps the moment, which a boolean would throw away.
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: rows are never removed, so an accidental delete is
  /// recoverable and sync can still see that something went.
  deletedAt DateTime?

  /// The list query is always "this user's, not deleted, ordered". Postgres
  /// can serve that straight from this index.
  @@index([userId, deletedAt, createdAt])
  @@map("todos")
}
