// Generator and datasource only. Models live in a file per domain beside this
// one — user.prisma, todo.prisma, and so on.
//
// Prisma reads every .prisma file in this folder and concatenates them, so the
// split costs nothing at runtime: relations work across files exactly as they
// did in one. There must be only one generator and one datasource in total,
// which is why they sit here on their own.
//
// Adding a domain: create <domain>.prisma next to this file. Nothing needs
// registering.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Required by the installed Prisma 6.19.3 CLI (prisma validate/migrate fail without it).
  // prisma.config.ts also sets datasource.url; drop this line only once on Prisma 7.
  url = env("DATABASE_URL")
}
