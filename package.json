{
  "name": "keel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev:web": "turbo run dev --filter=@keel/web",
    "dev:api": "turbo run dev --filter=@keel/api",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @keel/db run generate",
    "db:migrate": "pnpm --filter @keel/db run migrate",
    "db:studio": "pnpm --filter @keel/db run studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "turbo": "^2.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0"
  }
}
