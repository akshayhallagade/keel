{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@keel/types#build": { "dependsOn": ["^build"], "outputs": [] },
    "@keel/validation#build": { "dependsOn": ["^build"], "outputs": [] },
    "@keel/db#build": { "dependsOn": ["^build"], "outputs": [] },
    "@keel/api#build": { "dependsOn": ["^build"], "outputs": [] },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
